VITE_API_PROXY_TARGET=http://127.0.0.1:3001
VITE_API_BASE_URL=https://your-api-domain.example.com

# Les notifications email des formulaires sont envoyées par le backend
# (POST /api/notify → SMTP cPanel). Côté frontend, seul VITE_API_BASE_URL est
# nécessaire. La config SMTP se fait côté Cloud Run (voir api-server/.env.example).
